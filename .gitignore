# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Vite cache
.vite/

# Frontend-generated ZK assets (copied by `npm run prepare` from contracts/managed)
frontend/public/managed/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Contract artifacts (generated by `compact compile`)
# The compiled supply-chain circuits are committed so Vercel/CI can build the web demo.
contracts/managed/*
!contracts/managed/supply-chain/

# Deployment info
deployment.json

# Wallet seed (sensitive)

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Private state
*-state/
midnight-level-db/

# Temporary files
tmp/
temp/

# Midnight network state (per-network seeds, deploy addresses)
.midnight-state.json

# Midnight wallet sync state (per-network serialized wallet state cache)
.midnight-wallet-state/

# CLI-generated per-product seal codes (sensitive)
.supply-chain-secrets.json
.vercel
# Ignore .env.example
.env.example
