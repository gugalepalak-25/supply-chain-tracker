# ── Network ─────────────────────────────────────────────────────────────────────
# Target network: undeployed (local devnet), preview, or preprod.
# Can also be set via: npm run setup -- --network preprod
NETWORK=undeployed

# ── Wallet ──────────────────────────────────────────────────────────────────────
# Wallet seed (128 hex chars) or BIP-39 recovery phrase.
# Leave empty to auto-generate and persist in .midnight-state.json.
# MIDNIGHT_WALLET_SEED=
# MIDNIGHT_WALLET_MNEMONIC=

# ── Private state encryption ───────────────────────────────────────────────────
# Password used to encrypt the local private-state store (min 16 chars).
# The default is a devnet placeholder — set a real one for non-local networks.
# PRIVATE_STATE_PASSWORD=Local-Devnet-Development-Placeholder-1

# ── Faucet ──────────────────────────────────────────────────────────────────────
# Timeout (ms) when waiting for faucet funds on public networks (default: 600000).
# MIDNIGHT_FAUCET_TIMEOUT_MS=600000

# ── Network overrides (advanced) ────────────────────────────────────────────────
# Override individual endpoint URLs instead of using the built-in presets.
# MIDNIGHT_NODE_URL=ws://127.0.0.1:9944
# MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
# MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v4/graphql/ws
# MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# MIDNIGHT_FAUCET_URL=
