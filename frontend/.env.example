# Midnight network id the app connects to (preprod/mainnet).
VITE_NETWORK_ID=preprod

# On-chain contract address the app reads from and writes to.
VITE_CONTRACT_ADDRESS=5e08b7928d3c14c8605b7aa21117532525559a14784a71130b4def286d56786d

# Public Midnight indexer endpoints (GraphQL + WebSocket).
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# Where the compiled zk assets are served from (populated by `npm run prepare`).
VITE_ZK_CONFIG_BASE=/managed/supply-chain

# Where zero-knowledge proofs are generated:
#  - wallet  (default) — delegated to the connected wallet: wallets with
#    getProvingProvider() (e.g. 1AM) prove in-wallet; Lace uses its configured
#    proof server, falling back to VITE_PROOF_SERVER_URL
#  - server            — always use an HTTP proof server
VITE_PROVING=wallet
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300
